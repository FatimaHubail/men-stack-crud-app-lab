<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit <%= planet.name %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="page-container">
        <div class="header-div">
            <a href="/planets/<%= planet._id %>">&larr; Back to <%= planet.name %> Planet</a>
        </div>
        <h1>Edit <%= planet.name %></h1>

        <form action="/planets/<%= planet._id %>?_method=PUT" method="post">
            <div>
                <label for="name">Name</label>
                <input type="text" name="name" id="name" value="<%= planet.name %>">
            </div>

            <fieldset>
                <legend>Physical Characteristics</legend>

                <div>
                    <label for="composition">Composition</label>
                    <select name="composition" id="composition">
                        <option value="rock" <%= planet.composition === 'rock' ? 'selected' : '' %>>Rock</option>
                        <option value="gas" <%= planet.composition === 'gas' ? 'selected' : '' %>>Gas</option>
                        <option value="ice" <%= planet.composition === 'ice' ? 'selected' : '' %>>Ice</option>
                        <option value="metal" <%= planet.composition === 'metal' ? 'selected' : '' %>>Metal</option>
                    </select>
                </div>

                <div>
                    <label for="diameter">Diameter</label>
                    <div class="field-with-unit">
                        <input type="number" name="diameter" id="diameter" min="0" value="<%= planet.diameter %>">
                        <span class="unit">km</span>
                    </div>
                </div>

                <div>
                    <label for="surfaceTemperature">Surface Temperature</label>
                    <div class="field-with-unit">
                        <input type="number" name="surfaceTemperature" id="surfaceTemperature" value="<%= planet.surfaceTemperature %>">
                        <span class="unit">&deg;C</span>
                    </div>
                </div>

                <div>
                    <label for="atmosphere">Atmosphere</label>
                    <select name="atmosphere" id="atmosphere">
                        <option value="none" <%= planet.atmosphere === 'none' ? 'selected' : '' %>>None</option>
                        <option value="thin" <%= planet.atmosphere === 'thin' ? 'selected' : '' %>>Thin</option>
                        <option value="thick" <%= planet.atmosphere === 'thick' ? 'selected' : '' %>>Thick</option>
                        <option value="toxic" <%= planet.atmosphere === 'toxic' ? 'selected' : '' %>>Toxic</option>
                    </select>
                </div>

                <div class="checkbox-div">
                    <input type="checkbox" name="hasMagneticField" id="hasMagneticField" <%= planet.hasMagneticField ? 'checked' : '' %>>
                    <label for="hasMagneticField">Has Magnetic Field?</label>
                </div>
            </fieldset>

            <fieldset>
                <legend>Orbit &amp; Rotation</legend>

                <div>
                    <label for="distanceFromSun">Distance from Sun</label>
                    <div class="field-with-unit">
                        <input type="number" name="distanceFromSun" id="distanceFromSun" min="0" value="<%= planet.distanceFromSun %>">
                        <span class="unit">million km</span>
                    </div>
                </div>

                <div>
                    <label for="rotationPeriod">Rotation Period</label>
                    <div class="field-with-unit">
                        <input type="number" name="rotationPeriod" id="rotationPeriod" min="0" value="<%= planet.rotationPeriod %>">
                        <span class="unit">hours</span>
                    </div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Moons</legend>

                <div>
                    <label for="numOfMoons">Number of Moons</label>
                    <input type="number" name="numOfMoons" id="numOfMoons" min="0" step="1" value="<%= planet.numOfMoons %>">
                </div>

                <div>
                    <label for="moons">Moon Names (comma-separated)</label>
                    <input type="text" name="moons" id="moons" value="<%= planet.moons ? planet.moons.join(', ') : '' %>">
                </div>
            </fieldset>

            <fieldset>
                <legend>Discovery</legend>

                <div>
                    <label for="discoveryYear">Discovery Year</label>
                    <input type="number" name="discoveryYear" id="discoveryYear" min="0" step="1" value="<%= planet.discoveryYear %>">
                </div>

                <div>
                    <label for="discoveredBy">Discovered By</label>
                    <input type="text" name="discoveredBy" id="discoveredBy" value="<%= planet.discoveredBy %>">
                </div>

                <div class="checkbox-div">
                    <input type="checkbox" name="visitedByProbe" id="visitedByProbe" <%= planet.visitedByProbe ? 'checked' : '' %>>
                    <label for="visitedByProbe">Visited by Probe</label>
                </div>
            </fieldset>

            <button type="submit" class="btn btn-primary">Save Changes</button>
        </form>
    </div>
</body>
</html>
