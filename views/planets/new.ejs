<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Planet</title>
</head>
<body>
    <a href="/planets">Back to Planets</a>
    <h1>Add New Planet</h1>
    <form action="/planets" method="post">
        <label for="name">Name</label>
        <input type="text" name="name" id="name">
        
        <label for="composition">Composition</label>
        <select name="composition" id="composition">
            <option value="rock">Rock</option>
            <option value="gas">Gas</option>
            <option value="ice">Ice</option>
            <option value="metal">Metal</option>
        </select>

        <label for="diameter">Diameter</label>
        <input type="number" name="diameter" id="diameter" min="0"> <span>km</span>

        <label for="distanceFromSun">Distance from Sun</label>
        <input type="number" name="distanceFromSun" id="distanceFromSun" min="0"> <span>million km</span>

        <label for="rotationPeriod">Rotation Period</label>
        <input type="number" name="rotationPeriod" id="rotationPeriod" min="0"> <span>hours</span>

        <label for="surfaceTemperature">Surface Temperature</label>
        <input type="number" name="surfaceTemperature" id="surfaceTemperature"> <span>°C</span>

        <label for="numOfMoons">Numer of Moons</label>
        <input type="number" name="numOfMoons" id="numOfMoons" min="0" step="1">

        <label for="moons">Moon Names (comma-separated)</label>
        <input type="text" name="moons" id="moons">

        <div class="checkbox-div">
            <label for="hasMagneticField">Has Magnetic Field?</label>
            <input type="checkbox" name="hasMagneticField" id="hasMagneticField">
        </div>

        <label for="atmosphere">Atmosphere</label>
        <select name="atmosphere" id="atmosphere">
            <option value="none">None</option>
            <option value="thin">Thin</option>
            <option value="thick">Thick</option>
            <option value="toxic">Toxic</option>
        </select>

        <label for="discoveryYear">Discovery Year</label>
        <input type="number" name="discoveryYear" id="discoveryYear" min="0" step="1">

        <label for="discoveredBy">Discovered By</label>
        <input type="text" name="discoveredBy" id="discoveredBy">

        <div class="checkbox-div">
            <label for="visitedByProbe">Visited by Probe</label>
            <input type="checkbox" name="visitedByProbe" id="visitedByProbe">
        </div>

        <button type="submit">Add Planet</button>
    </form>
</body>
</html>